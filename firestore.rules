rules_version = '2';

// Role-based rules for bb-daily-ops-report.
// Requires a users/{uid} doc: { role: 'admin'|'director'|..., siteId?: 'crozet'|... }
// Deploy this BEFORE the open dev rules expire (2026-07-23). Until auth + users
// docs exist, the project is open read/write to anyone — do not load real data yet.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function role() {
      return userDoc().role;
    }
    // Site access as a list. Newer docs carry `siteIds`; legacy docs fall back
    // to their single `siteId`.
    function userSites() {
      return userDoc().get('siteIds', [userDoc().siteId]);
    }
    // Per-report grant for non-admins: '', 'view', or 'fill'.
    function reportLevel(k) {
      return userDoc().get('reportAccess', {}).get(k, '');
    }
    function canViewReport(k) {
      return role() == 'admin' || reportLevel(k) == 'view' || reportLevel(k) == 'fill';
    }
    function canFillReport(k) {
      return role() == 'admin' || reportLevel(k) == 'fill';
    }

    match /dailyOpsReports/{id} {
      allow read: if isSignedIn() && role() in ['admin', 'director'];

      allow create, update: if isSignedIn() && (
        role() == 'admin' ||
        (role() == 'director' && request.resource.data.siteId in userSites())
      );

      allow delete: if isSignedIn() && role() == 'admin';
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && role() == 'admin';
    }

    // Admin-curated "Director view" config (which dashboard cards directors see).
    match /config/{doc} {
      allow read: if isSignedIn() && role() in ['admin', 'director'];
      allow write: if isSignedIn() && role() == 'admin';
    }

    // Report data docs — admins, plus anyone granted access to that report.
    match /financeReports/{id} {
      allow read: if isSignedIn() && canViewReport('fdr');
      allow write: if isSignedIn() && canFillReport('fdr');
    }
    match /admissionsReports/{id} {
      allow read: if isSignedIn() && canViewReport('adr');
      allow write: if isSignedIn() && canFillReport('adr');
    }
    match /marketingReports/{id} {
      allow read: if isSignedIn() && canViewReport('mdr');
      allow write: if isSignedIn() && canFillReport('mdr');
    }
    match /executiveReports/{id} {
      allow read: if isSignedIn() && canViewReport('edr');
      allow write: if isSignedIn() && canFillReport('edr');
    }

    // Central Flags & Notes ledger for every report (tagged by `source`).
    // Admins read all (the Day Notes board); others read only a report they can
    // view (report page queries filter by source). Writers need fill on the source.
    match /orgDayNotes/{id} {
      allow read: if isSignedIn() && (role() == 'admin' || canViewReport(resource.data.source));
      allow create: if isSignedIn() && (role() == 'admin' || canFillReport(request.resource.data.source));
      allow update, delete: if isSignedIn() && (role() == 'admin' || canFillReport(resource.data.source));
    }
  }
}
